rules_version = '2';
// PressNex – Firestore-Sicherheitsregeln
// In der Firebase-Konsole einfügen: Firestore Database → Regeln → alles ersetzen → Veröffentlichen
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(me()); }
    function isAdmin() { return hasProfile() && get(me()).data.rolle == 'admin'; }

    // Profile der Pressesprecher
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || hasProfile();
      // Beim ersten Login legt die App das eigene Profil an – immer als Pressesprecher mit Pflicht zur Passwortänderung
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.rolle == 'sprecher'
        && request.resource.data.mustChangePw == true
        && request.resource.data.kuerzel == request.auth.token.email.split('@')[0].upper();
      // Eigenes Profil: nur Name und Passwort-Flag ändern; Admin darf alles (z. B. Rolle)
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'mustChangePw', 'updatedAt'])
          && request.resource.data.mustChangePw == false)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Einsatzberichte – alle freigeschalteten Pressesprecher dürfen lesen
    match /berichte/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile() && request.resource.data.autorUid == request.auth.uid;
      allow update: if hasProfile()
        && (resource.data.autorUid == request.auth.uid || isAdmin())
        && request.resource.data.autorUid == resource.data.autorUid;
      allow delete: if isAdmin();
    }

    // Stammdaten & KI-Einstellungen
    match /config/{docId} {
      allow read: if hasProfile();
      allow write: if isAdmin();
    }

    // Alles andere ist gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
